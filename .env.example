# Copy to .env.local and fill in real values. Never commit .env*.local.
# See README.md for where to get each key.

# --- Auth (required in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-generate-a-32-byte-secret

# --- MongoDB (required in production, optional locally) ---
# Without MONGODB_URI the app uses the local JSON store (dev-only:
# does not persist on serverless hosts). Get a free cluster at
# https://cloud.mongodb.com (Atlas → Connect → Drivers → Node.js).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=movade

# --- SMTP email (required for forgot-password emails) ---
# Gmail: host smtp.gmail.com, port 587, user = your Gmail address,
# pass = an App Password (Google Account → Security → 2-Step Verification
# → App passwords). A regular Gmail password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Movade <you@example.com>
# SMTP_SECURE=true  # only for port 465; leave unset for 587 (STARTTLS)
# The SAME SMTP settings above power signup/login email OTP codes —
# no extra email setup needed. Without SMTP, codes are logged server-side
# and shown in the UI in dev only.
